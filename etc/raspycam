#!/usr/bin/env bash
# Serialize launches, including the watchdog and web interface startup.
if [ "$#" -eq 0 ]; then
    set -- --config /etc/raspimjpeg
fi
flock -n -F "/tmp/raspycam-$(id -u).lock" bash -c '
    echo "$$" > /opt/vc/bin/raspycam/raspy.pid
    exec python3 -u /opt/vc/bin/raspycam/main.py "$@"
' raspycam "$@" >> /opt/vc/bin/raspycam/raspy.log 2>&1 &
